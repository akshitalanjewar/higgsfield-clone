{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": ".cursor/hooks/capture.cmd --event sessionStart",
        "timeout": 20
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": ".cursor/hooks/capture.cmd --event beforeSubmitPrompt",
        "timeout": 20
      }
    ],
    "afterAgentResponse": [
      {
        "command": ".cursor/hooks/capture.cmd --event afterAgentResponse",
        "timeout": 20
      }
    ],
    "stop": [
      {
        "command": ".cursor/hooks/capture.cmd --event stop",
        "timeout": 20
      }
    ]
  }
}
